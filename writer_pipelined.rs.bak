//! SCRATCH BACKUP — the two-thread pipelined writer, saved before rolling
//! `src/storage/writer.rs` back to the single-threaded original for an A/B.
//! Copy over `src/storage/writer.rs` to restore. Delete this file afterwards.

//! The writer threads and the three handles that talk to them.
//!
//! Writing is split across two threads so that filling the next batch overlaps
//! the `fsync` of the current one. The absorber owns the command queue and fills
//! a buffer; the committer owns the store and does the durable write. They pass
//! [`Batch`] values back and forth, and the fixed number of buffers in
//! circulation ([`PIPELINE_DEPTH`]) is what bounds how far the absorber may run
//! ahead.
//!
//! Batches stay ordered: `append` is positional at the store's current length,
//! so the committer has to see them in the order they were closed. A single
//! committer thread fed by one channel is what guarantees that.

use std::io;
use std::mem;
use std::sync::Arc;
use std::sync::atomic::{AtomicU64, Ordering};
use std::sync::mpsc as chan;
use std::thread::sleep;
use std::time::{Duration, Instant};

use tokio::sync::{Semaphore, mpsc, oneshot};

use crate::storage::frame::FRAME_MAX_SIZE;

use super::{Reader, Storage};

/// Soft cap on a group commit. Once the scratch buffer reaches this, the
/// absorber stops absorbing and writes what it has.
const MAX_BATCH: usize = 8 << 20;

/// Buffers in circulation: one being filled, one being committed. Raising it
/// would let the absorber close batches the committer has not started yet,
/// which adds queueing delay without adding throughput — the committer is
/// serial either way.
const PIPELINE_DEPTH: usize = 2;

/// Below this, a batch is not worth an `fsync` slot on its own, so the absorber
/// lingers for [`LINGER`] instead of shipping the instant the committer frees
/// up. `fsync` costs the same whether it covers 2 KiB or 800 KiB, so a
/// one-command batch spends a full slot to serve one caller.
const MIN_BATCH: usize = 64 << 10;

/// How long to hold a short batch open when the committer is already idle.
/// Bounds the latency this can add; against a multi-millisecond `fsync` it is
/// noise, and it is only ever paid when there was nothing else to send.
const LINGER: Duration = Duration::from_micros(200);

/// Per-batch commit tracing. Off by the time you are measuring anything: it is
/// one line per `fsync`, which is hundreds per second onto a terminal.
const TRACE_COMMITS: bool = true;

/// Blocking reads in flight, by default. Bounded because `spawn_blocking`'s own
/// pool is far larger than what a disk can usefully service at once.
pub const DEFAULT_READ_CONCURRENCY: usize = 32;

type AckResult = Result<(), Arc<io::Error>>;

enum Cmd {
    Append {
        data: Vec<u8>,
        ack: oneshot::Sender<AckResult>,
    },
    /// Contributes no bytes; just forces the batch it lands in to sync.
    Sync { ack: oneshot::Sender<AckResult> },
}

/// One group commit in flight, plus the acks it owes.
///
/// The same allocations cycle absorber -> committer -> absorber for the life of
/// the process, so the 8 MiB buffer is paid for once.
struct Batch {
    buf: Vec<u8>,
    waiters: Vec<oneshot::Sender<AckResult>>,
}

impl Batch {
    fn new() -> Self {
        Self {
            buf: Vec::with_capacity(FRAME_MAX_SIZE as usize),
            waiters: Vec::new(),
        }
    }
}

pub fn spawn<S: Storage>(store: S) -> (Writer, ReadHandle<S::Reader>, Handle<S>) {
    let start = store.len();

    let len = Arc::new(AtomicU64::new(start));

    let reader = ReadHandle {
        inner: store.reader(),
        len: Arc::clone(&len),
        reads: Arc::new(Semaphore::new(DEFAULT_READ_CONCURRENCY)),
    };

    let (tx, rx) = mpsc::channel(4096);

    // Closed batches go one way, emptied ones come back. Neither channel needs
    // a bound: only `PIPELINE_DEPTH` buffers ever exist, so the pool itself is
    // the backpressure.
    let (batch_tx, batch_rx) = chan::channel::<Batch>();
    let (free_tx, free_rx) = chan::channel::<Batch>();
    for _ in 0..PIPELINE_DEPTH {
        free_tx.send(Batch::new()).expect("free channel open");
    }

    let commit = std::thread::Builder::new()
        .name("storage-commit".into())
        .spawn(move || commit_loop(store, batch_rx, free_tx, len))
        .expect("spawn commit thread");

    let absorb = std::thread::Builder::new()
        .name("storage-absorb".into())
        .spawn(move || absorb_loop(rx, batch_tx, free_rx))
        .expect("spawn absorb thread");

    let writer = Writer {
        tx,
        buffered_size: Arc::new(Semaphore::new(DEFAULT_QUEUED_BYTES)),
    };

    (writer, reader, Handle { absorb, commit })
}

/// Fill a buffer, hand it over the instant the committer can take it, repeat.
///
/// That handoff rule *is* the group-commit policy, and it needs almost no
/// tuning. While the committer is busy the batch stays open, so every command
/// that arrives during those milliseconds rides along for free; the batch is
/// therefore always exactly one `fsync` wide. The one exception is [`LINGER`],
/// which stops a lone command from claiming a whole slot on an idle committer.
fn absorb_loop(
    mut rx: mpsc::Receiver<Cmd>,
    batch_tx: chan::Sender<Batch>,
    free_rx: chan::Receiver<Batch>,
) {
    let Ok(mut batch) = free_rx.recv() else { return };

    while let Some(cmd) = rx.blocking_recv() {
        absorb(cmd, &mut batch);
        drain(&mut rx, &mut batch);

        let next = match free_rx.try_recv() {
            // Committer is busy. Blocking here is the whole point: commands
            // pile up in `rx` for as long as the `fsync` runs, and the sweep
            // below claims every one of them for this batch.
            Err(chan::TryRecvError::Empty) => match free_rx.recv() {
                Ok(next) => next,
                Err(_) => return,
            },
            Err(chan::TryRecvError::Disconnected) => return,
            // Committer is idle and this batch is too thin to justify a slot.
            Ok(next) if batch.buf.len() < MIN_BATCH => {
                sleep(LINGER);
                next
            }
            Ok(next) => next,
        };

        drain(&mut rx, &mut batch);

        if batch_tx.send(mem::replace(&mut batch, next)).is_err() {
            return;
        }
    }
}

/// Move everything already queued into `batch`, stopping at [`MAX_BATCH`].
///
/// Never blocks. Anything left over stays in `rx` for the next batch.
fn drain(rx: &mut mpsc::Receiver<Cmd>, batch: &mut Batch) {
    while batch.buf.len() < MAX_BATCH {
        match rx.try_recv() {
            Ok(cmd) => absorb(cmd, batch),
            Err(_) => return,
        }
    }
}

fn commit_loop<S: Storage>(
    mut s: S,
    batch_rx: chan::Receiver<Batch>,
    free_tx: chan::Sender<Batch>,
    durable_bytes: Arc<AtomicU64>,
) -> (S, Option<Arc<io::Error>>) {
    let mut poison: Option<Arc<io::Error>> = None;

    while let Ok(mut batch) = batch_rx.recv() {
        let start = Instant::now();

        let res: AckResult = match poison.clone() {
            Some(e) => Err(e),
            None => commit(&mut s, &batch.buf, &durable_bytes).map_err(|e| {
                let e = Arc::new(e);
                poison = Some(Arc::clone(&e));
                e
            }),
        };

        let elapsed = start.elapsed();
        let size = batch.buf.len();
        let waiters = mem::take(&mut batch.waiters);

        // Recycle before acking. The absorber is blocked on this buffer, and
        // handing it back is what lets the next batch start filling; the acks
        // below are pure fan-out that nothing is waiting on.
        batch.buf.clear();
        let _ = free_tx.send(batch);

        for w in waiters {
            let _ = w.send(res.clone());
        }

        if TRACE_COMMITS {
            println!("commit took: {elapsed:.3?}, buf-size: {size} Bytes");
        }

        if let Some(cause) = poison.clone() {
            let offset = durable_bytes.load(Ordering::Relaxed);
            poison = match s.truncate(offset) {
                Ok(()) => None,
                Err(e) => Some(Arc::new(io::Error::other(format!(
                    "{cause}; repair failed: {e}"
                )))),
            };
        }
    }

    (s, poison)
}

fn commit<S: Storage>(s: &mut S, batch: &[u8], visible: &AtomicU64) -> io::Result<()> {
    let written = s.append(batch)?;
    visible.fetch_add(written, Ordering::Release);
    Ok(())
}

fn absorb(cmd: Cmd, batch: &mut Batch) {
    match cmd {
        Cmd::Append { mut data, ack } => {
            batch.buf.append(&mut data);
            batch.waiters.push(ack);
        }
        Cmd::Sync { ack } => {
            batch.waiters.push(ack);
        }
    }
}

pub const DEFAULT_QUEUED_BYTES: usize = 32 << 20;

/// Cloned per task. Every clone feeds the same writer thread.
#[derive(Clone)]
pub struct Writer {
    tx: mpsc::Sender<Cmd>,
    buffered_size: Arc<Semaphore>,
}

impl Writer {
    pub async fn append(&self, data: Vec<u8>) -> io::Result<()> {
        if data.len() > FRAME_MAX_SIZE as usize {
            return Err(io::Error::new(
                io::ErrorKind::InvalidInput,
                "frame to big".to_string(),
            ));
        }

        let _permit = Arc::clone(&self.buffered_size)
            .acquire_many_owned(data.len() as u32)
            .await
            .map_err(|_| io::Error::other("could not aquire quota semaphore"))?;

        self.dispatch(|ack| Cmd::Append { data, ack }).await
    }

    pub async fn sync(&self) -> io::Result<()> {
        self.dispatch(|ack| Cmd::Sync { ack }).await
    }

    async fn dispatch(
        &self,
        make: impl FnOnce(oneshot::Sender<AckResult>) -> Cmd + Send,
    ) -> io::Result<()> {
        let (ack, done) = oneshot::channel();
        self.tx
            .send(make(ack))
            .await
            .map_err(|_| io::Error::other("failed channel send"))?;
        match done.await {
            Ok(Ok(())) => Ok(()),
            Ok(Err(e)) => Err(clone_err(&e)),
            Err(e) => {
                println!("{e}");
                Err(io::Error::other("failed channel await"))
            }
        }
    }
}

/// Cloned per request. Cloning is two refcount bumps.
/// Every read is clamped to the visibility watermark, so a reader can never
/// observe bytes that a crash would take back.
#[derive(Clone)]
pub struct ReadHandle<R> {
    inner: R,
    len: Arc<AtomicU64>,
    reads: Arc<Semaphore>,
}

impl<R: Reader> ReadHandle<R> {
    pub fn len(&self) -> u64 {
        self.len.load(Ordering::Acquire)
    }

    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }

    pub fn read_at(&self, offset: u64, buf: &mut [u8]) -> io::Result<usize> {
        let end = self.len();
        if offset >= end {
            return Ok(0);
        }
        let want = ((end - offset) as usize).min(buf.len());
        if want == 0 {
            return Ok(0);
        }
        self.inner.read_at(offset, &mut buf[..want])
    }

    /// [`read_at`](Self::read_at) from async code, returning what was visible.
    pub async fn read(&self, offset: u64, len: usize) -> io::Result<Vec<u8>> {
        self.blocking(move |r| {
            let mut buf = vec![0u8; len];
            let n = r.read_at(offset, &mut buf)?;
            buf.truncate(n);
            Ok(buf)
        })
        .await
    }

    async fn blocking<T, F>(&self, f: F) -> io::Result<T>
    where
        T: Send + 'static,
        F: FnOnce(&Self) -> io::Result<T> + Send + 'static,
    {
        let permit = Arc::clone(&self.reads)
            .acquire_owned()
            .await
            .map_err(|_| io::Error::other("read semaphore closed"))?;
        let this = self.clone();
        tokio::task::spawn_blocking(move || {
            let _permit = permit;
            f(&this)
        })
        .await
        .map_err(|e| io::Error::other(format!("blocking read task failed: {e}")))?
    }
}

/// Owns both writer threads. Never cloned.
pub struct Handle<S> {
    absorb: std::thread::JoinHandle<()>,
    commit: std::thread::JoinHandle<(S, Option<Arc<io::Error>>)>,
}

impl<S: Send + 'static> Handle<S> {
    /// Wait for the writer threads to finish and surface the last error.
    ///
    /// Drop every [`Writer`] clone first, or this waits forever: the absorber
    /// exits when the command channel closes, and the committer exits when the
    /// absorber drops its end. `Drop` cannot report an error, which is why this
    /// exists.
    pub async fn close(self) -> io::Result<S> {
        tokio::task::spawn_blocking(move || self.close_blocking())
            .await
            .map_err(|e| io::Error::other(format!("join task failed: {e}")))?
    }

    /// Blocking [`close`](Self::close), for shutdown paths with no runtime.
    ///
    /// Both joins run before anything is reported: the committer only sees its
    /// channel close once the absorber is gone, so bailing on the first failure
    /// would leave it running.
    pub fn close_blocking(self) -> io::Result<S> {
        let absorb = self.absorb.join();
        let commit = self.commit.join();

        if absorb.is_err() {
            return Err(io::Error::other("storage absorb thread panicked"));
        }
        match commit {
            Ok((store, None)) => Ok(store),
            Ok((_, Some(e))) => Err(clone_err(&e)),
            Err(_) => Err(io::Error::other("storage commit thread panicked")),
        }
    }
}

/// `io::Error` is not `Clone`, and the batch fan-out needs one error per
/// waiter.
fn clone_err(e: &io::Error) -> io::Error {
    match e.raw_os_error() {
        Some(code) => io::Error::from_raw_os_error(code),
        None => io::Error::new(e.kind(), e.to_string()),
    }
}
